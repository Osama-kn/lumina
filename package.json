{
  "name": "lumina",
  "version": "1.0.0",
  "description": "Pull 3D models apart with your hands: hand-gesture controlled glowing particles in the browser. Drop in your own .glb. Hand-written WebGL2, no build step.",
  "type": "module",
  "private": true,
  "homepage": "https://osama-kn.github.io/lumina/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Osama-kn/lumina.git"
  },
  "bugs": {
    "url": "https://github.com/Osama-kn/lumina/issues"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build-site.mjs",
    "postinstall": "node scripts/fetch-model.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "capture": "node scripts/capture.mjs"
  },
  "keywords": [
    "webgl2",
    "particles",
    "mediapipe",
    "hand-tracking",
    "gestures",
    "transform-feedback",
    "gltf",
    "glb",
    "3d-model-viewer",
    "exploded-view"
  ],
  "author": "Oussama (Osama-kn)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "gifenc": "^1.0.3"
  }
}
